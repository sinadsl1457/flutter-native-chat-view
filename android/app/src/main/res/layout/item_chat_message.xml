<?xml version="1.0" encoding="utf-8"?>
<!--
    모든 메시지 셀의 공통 틀: [프로필] [닉네임 / (메타) 말풍선 (메타)]
    말풍선 자리(content_container)에는 뷰 타입별 콘텐츠를 ViewHolder 생성 시 한 번만 붙인다.
    바인딩 때는 값만 바꾼다 — 셀을 재사용할 때마다 뷰 트리를 새로 만들지 않는다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/chat_horizontal_padding"
    android:paddingEnd="@dimen/chat_horizontal_padding">

    <ImageView
        android:id="@+id/avatar"
        android:layout_width="@dimen/chat_avatar_size"
        android:layout_height="@dimen/chat_avatar_size"
        android:layout_marginEnd="8dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textColor="@color/chat_text_primary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/bubble_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <include
                android:id="@+id/meta_start"
                layout="@layout/view_message_meta" />

            <FrameLayout
                android:id="@+id/content_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/meta_end"
                layout="@layout/view_message_meta" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
